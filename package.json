{
  "name": "my-audio-visualizer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit:ci": "node scripts/audit-ci.mjs",
    "browsers:install": "playwright install chromium",
    "dev": "next dev",
    "build": "next build",
    "docs:screenshot": "npm run science:fixtures && node scripts/capture-readme.mjs",
    "start": "next start",
    "science:fixtures": "node scripts/generate-science-fixtures.mjs",
    "science:fixtures:check": "node scripts/generate-science-fixtures.mjs --check",
    "lint": "eslint .",
    "release:check": "npm run lint -- --max-warnings=0 && npm run type-check && npm test && npm run science:fixtures:check && npm run audit:ci && npm run build && npm run test:e2e:ci",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "pretest:e2e": "npm run science:fixtures && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ci": "npm run science:fixtures && playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^15.5.24",
    "react": "19",
    "react-dom": "19"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.18.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "15.5.22",
    "@playwright/test": "1.62.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "10.8.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "postcss": "8.5.24",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.24",
    "js-yaml": "4.3.0",
    "sharp": "0.35.3"
  }
}
