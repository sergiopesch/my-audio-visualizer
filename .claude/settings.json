{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",

      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(node *)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",

      "Bash(ls *)",
      "Bash(mkdir *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(doas *)",

      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(mount *)",

      "Bash(curl * | bash)",
      "Bash(wget * | bash)",

      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.gnupg/*)",
      "Bash(cat /etc/shadow*)",
      "Bash(cat *-key.pem*)",
      "Bash(cat *.pem*)",

      "Bash(printenv *)",
      "Bash(env)",
      "Bash(export *)"
    ]
  }
}
